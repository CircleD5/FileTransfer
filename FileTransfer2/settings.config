<?xml version="1.0" encoding="utf-8"?>
<!--
  動作設定（.NET 標準の設定ファイルの形式）
  ・フォルダの指定は、相対パスならアプリ（exe）のフォルダ基準です。
  ・パスはそのまま書けます（\ を重ねる必要はありません）。ただし & は &amp; と書きます。
  ・項目はすべて必須です。抜けや書き間違いがあると、起動時にエラーになります。
-->
<configuration>
  <configSections>
    <!-- 下の <fileTransfer> と <log4net> を読むための宣言（変更しない） -->
    <section name="fileTransfer" type="FileTransfer2.SettingsSection, FileTransfer2" />
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>

  <fileTransfer
    AutoRunIntervalMs="30000"
    RowDelayMs="200"
    AutoRunPlanDir="AutoRun\Plan"
    AutoRunDoneDir="AutoRun\Done"
    AutoRunErrorDir="AutoRun\Error"
    ProfilesDir="Profiles"
    DefaultProfile=""
    LogDir="C:\FileTransfer2Data\Logs"
    LogRetentionDays="90"
    BackupDir="C:\FileTransfer2Data\Backup"
    DeployKeepFile="deploy_keep.txt"
    ForbiddenPathsFile="forbidden_paths.txt" />
  <!--
    AutoRunIntervalMs  … 自動処理で Plan フォルダを確認する間隔（ミリ秒。1 以上）
    RowDelayMs         … 1行ごとの待ち時間（ミリ秒）
    AutoRunPlanDir     … 自動処理の計画ファイル（TSV）を置くフォルダ
    AutoRunDoneDir     … 自動処理で成功した計画ファイルを移す先
    AutoRunErrorDir    … 自動処理で失敗した計画ファイルを移す先
    ProfilesDir        … プロファイル（TSV）の保存先
    DefaultProfile     … 起動時に読み込むプロファイルの名前（Profiles フォルダの中のファイル名。.tsv は付けない）
                         読み込むだけで、実行はしない。空なら「未選択」で起動する（項目そのものは消さない）
                         例：DefaultProfile="Release_v1.2.0"
    LogDir             … ログファイル（日付ごと）の出力先
                         ※アプリのフォルダの外にする。リリースの後でアプリのフォルダを消しても、記録が残るように
    LogRetentionDays   … 日付ごとのログ（yyyyMMdd.log）を何日分残すか。起動時に古いものを消す。0 なら消さない
                         （配置の履歴 deploy_history.log は消さない）
    BackupDir          … 配置のときに、本番フォルダを退避する先（この下に「リリース番号」のフォルダが作られる）
                         ※アプリのフォルダの外にする。アプリのフォルダを消すと、切り戻しに必要な退避まで消えてしまうため
                         ※配置先と同じドライブにすると、移動だけで済むので速い
    DeployKeepFile     … 配置のときに、本番フォルダに残すものの一覧ファイル
    ForbiddenPathsFile … 実行を禁止するパスの一覧ファイル
    ※画面やログに出す文言（messages.json）は、このファイルと同じフォルダに置く
  -->

  <!--
    ログ（log4net）の設定
    ・出力先のフォルダは、上の LogDir が %property{LogDir} に入る（ここで別のフォルダを書かない）
    ・ファイル名は日付ごと（yyyyMMdd.log）。LogRetentionDays の古いログ削除は、この名前のファイルだけが対象
  -->
  <log4net>
    <appender name="DailyFile" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%property{LogDir}\" />
      <rollingStyle value="Date" />
      <datePattern value="yyyyMMdd'.log'" />
      <staticLogFileName value="false" />
      <appendToFile value="true" />
      <encoding value="utf-8" />
      <!-- 書くたびにファイルを閉じる（アプリを2つ起動しても、両方のログが書ける） -->
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date{yyyy/MM/dd HH:mm:ss} [%level] %message%newline" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="DailyFile" />
    </root>
  </log4net>
</configuration>
